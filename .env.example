# Template - copy to `.env` and fill in the real values.
#
#   cp .env.example .env
#
# `.env` is gitignored: never commit it. Hand the filled-in file to
# teammates out-of-band (password manager / chat), not through git.

# TiDB Cloud Serverless, database "redmine_1".
DB_USERNAME="paste-username-here"
DB_PASSWORD="paste-password-here"

# Signing key for cookies and sessions.
# MUST be identical on every machine sharing this database, otherwise login
# cookies issued by one instance are rejected by the other and signed tokens
# (e.g. password reset links) break. Copy the existing value; do not
# regenerate it. To create a fresh one: openssl rand -hex 64
REDMINE_SECRET_KEY_BASE="paste-64-byte-hex-here"

# Host port the Redmine UI is published on. Change it if 8080 is already
# in use on this machine.
REDMINE_HOST_PORT=8080

# Leave EMPTY on the one machine that owns database migrations (it runs
# `rake db:migrate` on startup). Set to 1 on every other machine so it does
# not migrate the shared database concurrently. See README.md.
REDMINE_NO_DB_MIGRATE=
